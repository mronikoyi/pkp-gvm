{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://community.invalid/pkp-gvm/schemas/operational-rule.schema.json",
  "title": "PKP operational rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ruleId",
    "productId",
    "preconditions",
    "setting",
    "consequence",
    "incompatibilities",
    "priority",
    "firmwareFrom",
    "firmwareTo",
    "evidenceIds",
    "verificationStatus"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "ruleId": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "productId": { "type": "string", "pattern": "^gvm\\." },
    "preconditions": { "type": "array", "items": { "type": "object" } },
    "setting": { "type": "object" },
    "consequence": { "type": "object" },
    "incompatibilities": { "type": "array", "items": { "type": "object" } },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "firmwareFrom": { "type": ["string", "null"], "pattern": "^\\d+(?:\\.\\d+)*$" },
    "firmwareTo": { "type": ["string", "null"], "pattern": "^\\d+(?:\\.\\d+)*$" },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "verificationStatus": {
      "enum": [
        "SOURCE_CONFIRMED",
        "CROSS_SOURCE_CONFIRMED",
        "HUMAN_REVIEW_REQUIRED",
        "CONFLICT",
        "UNKNOWN"
      ]
    }
  }
}
