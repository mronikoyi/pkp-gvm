{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://community.invalid/pkp-gvm/schemas/fact.schema.json",
  "title": "PKP fact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "factId",
    "productId",
    "category",
    "key",
    "value",
    "unit",
    "conditions",
    "firmwareFrom",
    "firmwareTo",
    "evidenceIds",
    "verificationStatus"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "factId": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "productId": { "type": "string", "pattern": "^gvm\\." },
    "category": {
      "enum": [
        "ELECTRICAL",
        "OPTICAL",
        "PHOTOMETRIC",
        "PHYSICAL",
        "CONTROL",
        "POWER",
        "FLASH_DURATION",
        "GUIDE_NUMBER",
        "COLOR",
        "BATTERY",
        "RADIO",
        "WEIGHT",
        "DIMENSION",
        "COMPATIBILITY",
        "RECYCLE",
        "BEAM_ANGLE",
        "FIRMWARE",
        "LIGHT_OUTPUT",
        "COOLING",
        "MOUNTING",
        "OTHER"
      ]
    },
    "key": { "type": "string", "minLength": 1 },
    "value": {},
    "unit": { "type": ["string", "null"] },
    "conditions": {
      "type": "object",
      "properties": {
        "iso": { "type": ["integer", "null"] },
        "zoom": { "type": ["string", "null"] },
        "reflector": { "type": ["string", "null"] },
        "distance": { "type": ["string", "null"] },
        "cct": { "type": ["string", "null"] },
        "mode": { "type": ["string", "null"] },
        "power": { "type": ["string", "null"] },
        "flashDurationConvention": { "type": ["string", "null"], "enum": ["t0.1", "t0.5", null] },
        "note": { "type": ["string", "null"] }
      }
    },
    "firmwareFrom": { "type": ["string", "null"], "pattern": "^\\d+(?:\\.\\d+)*$" },
    "firmwareTo": { "type": ["string", "null"], "pattern": "^\\d+(?:\\.\\d+)*$" },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "verificationStatus": {
      "enum": [
        "SOURCE_CONFIRMED",
        "CROSS_SOURCE_CONFIRMED",
        "HUMAN_REVIEW_REQUIRED",
        "CONFLICT",
        "UNKNOWN"
      ]
    }
  }
}
