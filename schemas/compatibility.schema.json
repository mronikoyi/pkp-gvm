{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://community.invalid/pkp-gvm/schemas/compatibility.schema.json",
  "title": "PKP compatibility relation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "relationId",
    "subjectId",
    "predicate",
    "objectId",
    "evidenceIds",
    "verificationStatus"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "relationId": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "subjectId": { "type": "string", "pattern": "^gvm\\." },
    "predicate": {
      "enum": [
        "SUPPORTS_TTL",
        "SUPPORTS_HSS",
        "SUPPORTS_TRIGGER",
        "SUPPORTS_MODIFIER",
        "SUPPORTS_SOFTBOX",
        "SUPPORTS_SPEEDRING",
        "SUPPORTS_BOWENS",
        "SUPPORTS_LANTERN",
        "SUPPORTS_GVM_MOUNT",
        "REQUIRES_BATTERY",
        "REQUIRES_POWER_PACK",
        "COMPATIBLE_WITH_BRAND",
        "INCOMPATIBLE_WITH_BRAND",
        "IS_VARIANT_OF",
        "REPLACES",
        "DEPRECATED_BY",
        "TRIGGER_DEPENDENCY",
        "FIRMWARE_REQUIRED",
        "ALTERNATIVE_TO"
      ]
    },
    "objectId": { "type": "string" },
    "strength": {
      "enum": ["CONFIRMED", "LIKELY", "UNVERIFIED", "CONFLICTING"]
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "verificationStatus": {
      "enum": [
        "SOURCE_CONFIRMED",
        "CROSS_SOURCE_CONFIRMED",
        "HUMAN_REVIEW_REQUIRED",
        "CONFLICT",
        "UNKNOWN"
      ]
    }
  }
}
