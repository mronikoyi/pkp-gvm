{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://community.invalid/pkp-gvm/schemas/menu-path.schema.json",
  "title": "PKP menu path",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "menuPathId",
    "productId",
    "language",
    "translationStatus",
    "firmwareFrom",
    "firmwareTo",
    "startPoint",
    "steps",
    "evidenceIds",
    "page",
    "verificationStatus"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "menuPathId": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "productId": { "type": "string", "pattern": "^gvm\\." },
    "language": { "type": "string", "minLength": 2 },
    "translationStatus": {
      "enum": [
        "OFFICIAL",
        "UNVERIFIED_TRANSLATION",
        "AI_TRANSLATED_UNVERIFIED"
      ]
    },
    "firmwareFrom": { "type": ["string", "null"], "pattern": "^\\d+(?:\\.\\d+)*$" },
    "firmwareTo": { "type": ["string", "null"], "pattern": "^\\d+(?:\\.\\d+)*$" },
    "startPoint": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "page": { "type": ["integer", "null"], "minimum": 0 },
    "verificationStatus": {
      "enum": [
        "SOURCE_CONFIRMED",
        "CROSS_SOURCE_CONFIRMED",
        "HUMAN_REVIEW_REQUIRED",
        "CONFLICT",
        "UNKNOWN"
      ]
    }
  }
}
