{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://community.invalid/pkp-gvm/schemas/firmware-history.schema.json",
  "title": "PKP firmware history event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "firmwareEventId",
    "productId",
    "version",
    "releaseDate",
    "sourceId",
    "evidenceIds",
    "verificationStatus"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "firmwareEventId": { "type": "string", "pattern": "^fw-[a-z0-9._-]+$" },
    "productId": { "type": "string", "pattern": "^gvm\\." },
    "version": { "type": "string", "pattern": "^\\d+(?:\\.\\d+)*$" },
    "releaseDate": { "type": ["string", "null"] },
    "changelog": { "type": ["string", "null"] },
    "sourceId": { "type": "string", "pattern": "^src-[a-z0-9_-]+$" },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "verificationStatus": {
      "enum": [
        "SOURCE_CONFIRMED",
        "CROSS_SOURCE_CONFIRMED",
        "HUMAN_REVIEW_REQUIRED",
        "CONFLICT",
        "UNKNOWN"
      ]
    }
  }
}
