{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PKP Collection Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "id",
    "name",
    "packType",
    "version",
    "description",
    "publisher",
    "repository",
    "license",
    "languages",
    "requirements",
    "modules",
    "installProfiles",
    "rightsStatus"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "specVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "packType": {
      "const": "COLLECTION"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "github",
        "publicKeyId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "github": {
          "type": "string"
        },
        "publicKeyId": {
          "type": "string"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "commit"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "name",
        "url",
        "acceptanceRequired"
      ],
      "properties": {
        "spdx": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "acceptanceRequired": {
          "type": "boolean"
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "products": {
      "type": "array"
    },
    "firmwareCoverage": {
      "type": "array"
    },
    "dependencies": {
      "type": "array"
    },
    "requirements": {
      "type": "object",
      "properties": {
        "minAppVersion": {
          "type": "string"
        },
        "pkpSpec": {
          "type": "string"
        }
      }
    },
    "rag": {
      "type": "object",
      "properties": {
        "chunks": {
          "type": "object"
        },
        "lexicalIndex": {
          "type": "object"
        },
        "vectorIndex": {
          "type": "object"
        }
      }
    },
    "contents": {
      "type": "array"
    },
    "build": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "toolVersion": {
          "type": "string"
        }
      }
    },
    "modules": {
      "type": "array"
    },
    "installProfiles": {
      "type": "object"
    },
    "rightsStatus": {
      "type": "string"
    }
  }
}