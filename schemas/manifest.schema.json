{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://community.invalid/pkp-gvm/schemas/manifest.schema.json",
  "title": "PKP manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "name",
    "version",
    "publisher",
    "repository",
    "license",
    "languages",
    "requirements",
    "modules",
    "installProfiles",
    "rightsStatus",
    "signatureStatus"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "packId": { "type": "string", "pattern": "^gvm\\.[a-z0-9.-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "publisher": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "repository": {
      "type": "object",
      "properties": {
        "type": { "const": "git" },
        "url": { "type": ["string", "null"] }
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "data": { "type": "string" }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "pkpSpecVersion": { "const": "1.0" },
        "minAppVersion": { "type": "string" }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "productIds": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "installProfiles": {
      "type": "object",
      "properties": {
        "CATALOG_ONLY": { "type": "array", "items": { "type": "string" } },
        "OWNED_GEAR": { "type": "array", "items": { "type": "string" } },
        "FULL_OFFLINE": { "type": "array", "items": { "type": "string" } },
        "CUSTOM": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["CATALOG_ONLY", "OWNED_GEAR", "FULL_OFFLINE"]
    },
    "rightsStatus": { "type": "string" },
    "signatureStatus": { "type": "string" }
  }
}
