{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://community.invalid/pkp-gvm/schemas/source.schema.json",
  "title": "PKP source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceId",
    "url",
    "title",
    "trustStatus",
    "archivedAt",
    "accessStatus",
    "lastModified"
  ],
  "properties": {
    "sourceId": { "type": "string", "pattern": "^src-[a-z0-9_-]+$" },
    "url": { "type": "string", "format": "uri" },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string" },
    "trustStatus": {
      "enum": ["OFFICIAL", "AFFILIATED", "THIRD_PARTY", "UNKNOWN"]
    },
    "archivedAt": { "type": ["string", "null"], "format": "date-time" },
    "accessStatus": {
      "enum": ["ACCESSIBLE", "RESTRICTED", "BLOCKED", "NOT_FOUND", "UNVERIFIED"]
    },
    "lastModified": { "type": ["string", "null"] },
    "languages": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
