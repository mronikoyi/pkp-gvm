{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://community.invalid/pkp-gvm/schemas/product.schema.json",
  "title": "PKP product identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "productId",
    "productKind",
    "brand",
    "displayName",
    "familyName",
    "regions",
    "languages",
    "collectionStatus",
    "coverageFlags",
    "sourceIds"
  ],
  "properties": {
    "productId": {
      "type": "string",
      "pattern": "^gvm\\.",
      "description": "gvm.category.base-model"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "mount": {
      "type": "object",
      "properties": {
        "mountId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "productKind": {
      "enum": [
        "FLASH_ON_CAMERA",
        "FLASH_OFF_CAMERA",
        "STROBE",
        "CONTINUOUS_LIGHT",
        "LED_PANEL",
        "TRIGGER",
        "MODIFIER",
        "POWER",
        "ACCESSORY"
      ]
    },
    "brand": { "const": "GVM" },
    "displayName": { "type": "string", "minLength": 1 },
    "familyName": { "type": "string", "minLength": 1 },
    "collectionStatus": {
      "enum": [
        "COLLECTED",
        "NOT_COLLECTED",
        "DISCOVERED",
        "UNAVAILABLE",
        "DEPRECATED"
      ]
    },
    "coverageFlags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "IDENTITY_ONLY",
          "PILOT",
          "FULL",
          "REVIEW_NEEDED",
          "CONFLICT",
          "OBSOLETE"
        ]
      }
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  }
}
