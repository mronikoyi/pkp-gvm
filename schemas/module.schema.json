{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://community.invalid/pkp-gvm/schemas/module.schema.json",
  "title": "PKP module",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "kind",
    "productIds",
    "dependencies",
    "languages"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^gvm\\.[a-z0-9._-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "kind": {
      "enum": ["BRAND", "CATALOG", "COMPATIBILITY", "INDEX", "MATRIX", "PRODUCT", "ACCESSORY"]
    },
    "description": { "type": "string" },
    "productIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    }
  }
}
